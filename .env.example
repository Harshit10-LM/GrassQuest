# ==============================================================================
# GrassQuest Environment Configuration
# ==============================================================================

# Groq API Configuration
# Get your free/creator API key at: https://console.groq.com/keys
# Groq provides fast inference for open-weight models including GPT-OSS 20B
GROQ_API_KEY=your_groq_api_key_here

# Open-weight AI model to run on Groq
# Default intended model: openai/gpt-oss-20b
# Fallback/alternative tested open-weight models: llama-3.3-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=openai/gpt-oss-20b

# ElevenLabs API Configuration
# Get your API key through Hacktoberfest Creator Perks or https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Default ElevenLabs Voice ID (e.g. 21m00Tcm4TlvDq8ikWAM = Rachel / friendly narrative voice)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Flask Server Configuration
PORT=5001
FLASK_DEBUG=false
